# Copy this file to .env (gitignored) and fill it in. Every npm script except `test` loads it.

# Storage. Hosted: Supabase Postgres (authoritative). Offline: CONTINUITY_STORE=sqlite (plus CONTINUITY_DB) or memory.
# If none of these is set the server refuses to start; there is no silent fallback.
SUPABASE_DB_URL=
# Optional private Storage bucket for attachment bytes. Server-side key only; never hand it to agents.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# postgres | sqlite | memory (inferred when empty)
CONTINUITY_STORE=
# Org for signed webhooks and auth-off mode (default org_local)
CONTINUITY_ORG=
# Token for agents, the MCP server and scripts, minted with `npm run token` (hosted mode requires one)
CONTINUITY_TOKEN=

# Optional overrides (defaults shown in README → Environment):
# CONTINUITY_DB=data/continuity.db   # SQLite file; setting it selects offline SQLite mode
# CONTINUITY_AUTH=                   # bearer tokens on API routes: `required` with Postgres, otherwise `off`
# CONTINUITY_WORKER=off              # no embedded job worker; run `npm run worker` separately
# PORT=4100
# CONTINUITY_URL=http://localhost:4100

# Claude: turns on the LLM extractor and the LLM agent (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Only for keys that are not scoped to a workspace (error: "must include the anthropic-workspace-id header")
ANTHROPIC_WORKSPACE_ID=

# Send check: Claude's second opinion on whether a counterparty email commits us (on when ANTHROPIC_API_KEY is set).
# off disables it (tripwire + declared intent only); the model defaults to the extractor's.
CONTINUITY_SEND_CHECK=
CONTINUITY_SEND_CHECK_MODEL=

# Human approval. Approver tokens: `npm run token -- --kind approver --label "<name>"` (never give one to an agent;
# the operator wildcard does not include approval). Cards expire after CONTINUITY_APPROVAL_TTL_H hours (default 48);
# new cards are posted to CONTINUITY_APPROVAL_WEBHOOK (Slack-style {"text": ...}) with a link under CONTINUITY_PUBLIC_URL.
CONTINUITY_APPROVAL_TTL_H=
CONTINUITY_APPROVAL_WEBHOOK=
CONTINUITY_PUBLIC_URL=

# Primitive: turns on live mail (https://www.primitive.dev/app/settings/api-keys)
PRIMITIVE_API_KEY=
# Only if a Primitive webhook points at POST /webhooks/primitive (otherwise `npm run receive` long-polls)
PRIMITIVE_WEBHOOK_SECRET=

# Live-mode addresses. SELF is the agent's Primitive inbox; SUPPLIER and FINANCE are two more inboxes you
# control (e.g. other addresses on your *.primitive.email domain) so scripts/live-counterparty.ts can play them.
CONTINUITY_SELF_ADDRESS=
CONTINUITY_SUPPLIER_ADDRESS=
CONTINUITY_FINANCE_ADDRESS=
